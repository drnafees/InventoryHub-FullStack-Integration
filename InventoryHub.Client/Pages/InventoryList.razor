@page "/inventory"
@using InventoryHub.Shared.Models
@using InventoryHub.Client.Services
@inject IInventoryApiClient ApiClient

<h3>Inventory Dashboard</h3>

<div class="row mb-3">
    <div class="col-md-4">
        <input type="text" class="form-control" placeholder="Search by name or SKU..." @bind="searchTerm" @bind:event="oninput" @onkeyup="FilterChanged" />
    </div>
</div>

@if (isLoading)
{
    <p><em>Loading inventory items...</em></p>
}
else if (pagedResult != null && pagedResult.Items.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>SKU</th>
                <th>Category</th>
                <th>Quantity</th>
                <th>Unit Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in pagedResult.Items)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.SKU</td>
                    <td>@item.Category</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No inventory items found.</p>
}

@code {
    private PagedResult<InventoryItem>? pagedResult;
    private string? searchTerm;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task FilterChanged()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        pagedResult = await ApiClient.GetItemsAsync(searchTerm, null, 1, 10);
        isLoading = false;
    }
}